server.port=9090

# JWT 鉴权（生产环境请改为足够长的随机字符串，勿提交真实密钥）
auth.jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
auth.jwt.expire-days=7

# 数据库配置（请按本地环境修改）
spring.datasource.url=jdbc:mysql://localhost:3307/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# 上传限制
spring.servlet.multipart.max-file-size=2048MB
spring.servlet.multipart.max-request-size=2048MB

# MyBatis（默认不打印 SQL；调试 mapper 时：logging.level.com.example.server.mapper=DEBUG）
logging.level.com.example.server.mapper=WARN

# ==============================
# AI 服务配置（请填入你自己的 API Key）
# ==============================
ai.deepseek.api-key=YOUR_DEEPSEEK_OR_SILICONFLOW_API_KEY
ai.deepseek.base-url=https://api.siliconflow.cn/v1
ai.deepseek.model=deepseek-ai/DeepSeek-V3
# 总结/问答单次送入模型的最大字符数（长上下文模型可增大，如 200000）
ai.deepseek.max-input-chars=200000
ai.deepseek.read-timeout-seconds=900
ai.aliyun.api-key=YOUR_ALIYUN_API_KEY

# ASR 单段最长秒数（SiliconFlow 限制 1 小时，默认 3300 = 55 分钟）
asr.max-segment-seconds=3300

# RAG（Embedding + 检索）
# bge-large-zh-v1.5 约 512 token/条；长切片用 BAAI/bge-m3 并配合 ai.embedding.max-input-chars
ai.embedding.model=BAAI/bge-m3
ai.embedding.max-input-chars=1500
# bge-large 检索 query 前缀；留空则 bge-large 自动加中文前缀，bge-m3 无需前缀
# ai.embedding.query-prefix=
rag.chunk.size=500
rag.chunk.overlap=80
rag.retrieve.top-k=8
rag.embed.batch-size=8
rag.qa.history-limit=100

# ==========================================
# Redis 配置
# ==========================================
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.database=0
spring.data.redis.timeout=3000ms

# ==========================================
# MinIO 配置
# ==========================================
minio.endpoint=http://localhost:9000
minio.accessKey=YOUR_MINIO_ACCESS_KEY
minio.secretKey=YOUR_MINIO_SECRET_KEY
minio.bucketName=media

# ==========================================
# 外部工具路径（按本机实际路径修改）
# Windows 请用正斜杠 D:/apps/...，勿写 D:\apps\...（\f \t 会被 properties 转义）
# ==========================================
tool.ytdlp.path=C:/path/to/yt-dlp.exe
tool.ffmpeg.dir=C:/path/to/ffmpeg/bin

# ================= RocketMQ 配置 =================
rocketmq.name-server=127.0.0.1:9876
rocketmq.producer.group=video-analysis-group
rocketmq.producer.send-message-timeout=3000
# Docker 本地开发：客户端默认连 Broker VIP 端口 10909，容器内常不可用 → 关闭后走 10911
rocketmq.producer.vip-channel-enabled=false
rocketmq.consumer.vip-channel-enabled=false
